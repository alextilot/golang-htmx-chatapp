package chat

import (
	"time"

	"github.com/alextilot/golang-htmx-chatapp/internal/model"
	"github.com/alextilot/golang-htmx-chatapp/web/components/avatar"
)

// TODO: I do not like how the form and textarea have a circular dependancy.
// The form manages default submit & htmx:evnet: send-message.
// After websocket send, the UI/UX needs to "reset" the textarea's state.
templ Input() {
	<form
		id="chat-form"
		ws-send
		hx-trigger="submit, send-message"
		hx-on::ws-after-send="resetTextarea('#text-message')"
		class="flex-none border-t border-base-300 bg-base-100 p-3"
	>
		<label for="text-message" class="sr-only">Your message</label>
		<div class="flex items-end gap-2">
			<textarea
				form="chat-form"
				id="text-message"
				rows="1"
				placeholder="Type your message..."
				class="textarea no-scrollbar w-full resize-none"
				name="Content"
				maxlength="5000"
				onInput="autoHeight(this)"
				hx-on:keypress="sendMessageOnEnter(event)"
			></textarea>
			<button
				type="submit"
				class="btn btn-circle btn-ghost text-primary"
			>
				<svg
					class="w-5 h-5 rotate-90 rtl:-rotate-90"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					fill="currentColor"
					viewBox="0 0 18 20"
				>
					<path
						d="m17.914 18.594-8-18a1 1 0 0 0-1.828 0l-8 18a1 1 0 0 0 1.157 1.376L8 18.281V9a1 1 0 0 1 2 0v9.281l6.758 1.689a1 1 0 0 0 1.156-1.376Z"
					></path>
				</svg>
				<span class="sr-only">Send message</span>
			</button>
		</div>
		<script>
			const autoHeight = (elem) => {
				elem.style.height = '1px';
				elem.style.height = `${elem.scrollHeight}px`;
			}
			// Event handler, emits "send-message" if enter is pressed with no modifier key
			const sendMessageOnEnter = (event) => {
				if (event.key === "Enter" && !(event.shiftKey || event.altKey || event.ctrlKey || event.metaKey)) {
					event.preventDefault();
					htmx.trigger(event.target, "send-message");
				}
			};
			const resetTextarea = (selectors) => {
				const element = document.querySelector(selectors)
				if (element != null) {
					element.value = "";
					autoHeight(element)
				}
			};
		</script>
	</form>
}

// Message renders one chat bubble in place — used for history (initial load
// and scroll-up pagination), which is normal in-page content, not a swap.
templ Message(name string, content string, time string, isSelf bool) {
	<div class={ "chat", templ.KV("chat-start", !isSelf), templ.KV("chat-end", isSelf) }>
		<div class="chat-image">
			@avatar.Circle(name, "w-10", "", avatar.ColorFor(name), false)
		</div>
		<div class="chat-header">
			{ name }
			<time class="text-xs opacity-50">{ time }</time>
		</div>
		<div class="chat-bubble">{ content }</div>
		<div class="chat-footer opacity-50">
			Delivered
		</div>
	</div>
}

// LiveMessage wraps Message for WebSocket delivery: an OOB target is the
// only way to place a message from a WS frame, which is why Message alone
// doesn't carry one — reusing that wrapper in HistoryPage's swap responses
// was the bug that sent scroll-up pages to the bottom instead of the top.
templ LiveMessage(name string, content string, time string, isSelf bool) {
	<div hx-swap-oob="beforebegin:#chatroom-bottom">
		@Message(name, content, time, isSelf)
	</div>
}

const messageTimeLayout = "2006-01-02 3:04:05 pm"

// HistoryPage renders one batch of messages, oldest first, with a leading
// sentinel (when hasMore) that loads the next older page on scroll-up.
templ HistoryPage(groupID string, messages []model.UserMessage, currentUserID string, hasMore bool) {
	if hasMore && len(messages) > 0 {
		<div
			class="h-1"
			hx-get={ "/groups/" + groupID + "/messages?before=" + messages[0].CreatedAt.Format(time.RFC3339Nano) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
			hx-on::before-request="beforeLoadMoreMessages()"
			hx-on::after-swap="afterLoadMoreMessages()"
		></div>
	}
	for _, um := range messages {
		@Message(um.Message.Sender.Username, um.Message.Content, um.CreatedAt.Format(messageTimeLayout), um.Message.SenderID == currentUserID)
	}
}

// GroupChatroom connects to the group's WebSocket room and renders the most
// recent page of history before any live messages arrive.
templ GroupChatroom(groupID string, history []model.UserMessage, hasMore bool, currentUserID string) {
	<div
		class="flex min-h-0 flex-1 flex-col"
		hx-ext="ws"
		ws-connect={ "/ws/groups/" + groupID }
	>
		<div id="message-scroll" class="min-h-0 flex-1 overflow-y-auto">
			<scroller class="scroller flex flex-col pb-4">
				@HistoryPage(groupID, history, currentUserID, hasMore)
				<anchor id="chatroom-bottom" class="anchor"></anchor>
			</scroller>
		</div>
		<script>
			(function () {
				var el = document.getElementById('message-scroll');
				if (el) el.scrollTop = el.scrollHeight;
			})();

			// Prepending an older page above the scroll position would yank
			// the view down by the new content's height without this.
			function beforeLoadMoreMessages() {
				var el = document.getElementById('message-scroll');
				if (el) el.dataset.prevScrollHeight = el.scrollHeight;
			}
			function afterLoadMoreMessages() {
				var el = document.getElementById('message-scroll');
				if (el && el.dataset.prevScrollHeight) {
					el.scrollTop += el.scrollHeight - parseInt(el.dataset.prevScrollHeight, 10);
				}
			}
		</script>
		@Input()
	</div>
}
