						target="_blank"
						rel="noopener noreferrer"
						class="card bg-base-200 border border-base-300 hover:border-primary/50 hover:-translate-y-1 shadow-sm hover:shadow-lg transition-all duration-200"
					>
						<div class="card-body items-center text-center gap-3 py-6">
							<div class="w-12 h-12 rounded-full bg-base-100 flex items-center justify-center">
