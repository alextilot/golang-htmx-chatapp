package pages

import (
	"github.com/alextilot/golang-htmx-chatapp/web/layouts"
)

templ AboutPage() {
	@layouts.LayoutBase("Chatter — About", true) {
		<main class="w-full min-h-screen bg-base-100 flex flex-col items-center justify-start p-8">
			<div class="text-center max-w-4xl space-y-8">
				<h1 class="text-5xl font-bold text-primary">About Chatter</h1>
				<p class="text-lg text-base-content/70">
					Chatter is a real-time chat application designed for seamless communication.
				</p>
				<div class="divider"></div>
				<div class="text-xl font-medium">Built with</div>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
					<a
