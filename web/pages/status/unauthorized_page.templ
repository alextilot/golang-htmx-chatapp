package status

import (
	"github.com/alextilot/golang-htmx-chatapp/web/layouts"
	"github.com/alextilot/golang-htmx-chatapp/internal/routes"
)

templ UnauthorizedPage() {
	@layouts.LayoutBase("Unauthorized", true) {
		<div class="flex flex-col items-center justify-center space-y-6 text-center w-full">
			<div class="text-center space-y-6">
				<h1 class="text-8xl font-extrabold text-error">401</h1>
				<p class="text-2xl text-base-content/70">You need to log in to access this page.</p>
				<a href={ routes.Routes.LoginPage.Path } class="btn btn-primary btn-lg">Log In</a>
			</div>
		</div>
	}
}
