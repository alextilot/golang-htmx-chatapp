package status

import (
	"github.com/alextilot/golang-htmx-chatapp/web/layouts"
	"github.com/alextilot/golang-htmx-chatapp/internal/routes"
)

templ ForbiddenPage() {
	@layouts.LayoutBase("Forbidden", true) {
		<div class="flex flex-col items-center justify-center space-y-6 text-center w-full">
			<div class="text-center space-y-6">
				<h1 class="text-8xl font-extrabold text-error">403</h1>
				<p class="text-2xl text-base-content/70">Sorry, you do not have permission to access this page.</p>
				<a href={ routes.Routes.HomePage.Path } class="btn btn-primary btn-lg">Go Home</a>
			</div>
		</div>
	}
}
