package pages

import (
	"github.com/alextilot/golang-htmx-chatapp/web/layouts"
	"github.com/alextilot/golang-htmx-chatapp/web/partials"
)

templ NotFoundPage() {
	@layouts.MainLayout() {
		@partials.NavigationBar()
		<main class="min-h-screen bg-base-200 flex flex-col items-center justify-center p-4">
			<div class="text-center space-y-6">
				<h1 class="text-8xl font-extrabold text-error">404</h1>
				<p class="text-2xl text-base-content/70">Oops! The page you are looking for does not exist.</p>
				<a href="/" class="btn btn-primary btn-lg">Go Home</a>
			</div>
		</main>
	}
}
