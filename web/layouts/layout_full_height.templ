package layouts

import (
	"github.com/alextilot/golang-htmx-chatapp/web/partials"
)

// FullHeight layout: an app shell capped to exactly one viewport
// (h-dvh + overflow-hidden on its own wrapper, not the shared Document body
// — other pages via LayoutBase still scroll normally). main gets flex-1
// min-h-0 so it's the precise remaining space after an optional header/
// footer; that's what lets its children's own overflow-y-auto regions
// (e.g. a sidebar's group list, a chat's message scroller) actually clip
// and scroll internally instead of the whole page scrolling.
templ LayoutFullHeight(title string, includeHeader bool, includeFooter bool) {
	@Document(title) {
		<div class="flex h-dvh flex-col overflow-hidden">
			if includeHeader {
				<header class="flex-none">
					@partials.NavigationBar()
				</header>
			}
			<main class="flex flex-1 flex-col min-h-0">
				{ children... }
			</main>
			if includeFooter {
				<footer class="flex-none bg-base-200 p-4 text-center">
					@partials.Footer()
				</footer>
			}
		</div>
	}
}
