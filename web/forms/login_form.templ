package forms

import (
	"github.com/alextilot/golang-htmx-chatapp/web/components/form"
	"github.com/alextilot/golang-htmx-chatapp/internal/routes"
	"github.com/alextilot/golang-htmx-chatapp/internal/apperr"
)

// LoginFormValues carries back what the user typed so a validation error
// doesn't wipe fields they already got right.
type LoginFormValues struct {
	Username string
}

templ LoginForm(fieldErrors apperr.FieldErrors, values LoginFormValues) {
	<div id="login-form" class="card shrink-0 w-full shadow-2xl bg-base-100 p-8" hx-ext="response-targets, debug">
		<h1 class="text-2xl font-semibold text-center">Login</h1>
		<form
			class="card-body space-y-4"
			hx-boost="true"
			action={ routes.Routes.LoginPage.Path }
			method="post"
			hx-target="#login-form"
			hx-target-error="#login-form"
			hx-swap="outerHTML"
			hx-indicator="#spinner"
		>
			@form.Input(
				templ.Attributes{
					"type":         "text",
					"placeholder":  "Username",
					"name":         "username",
					"autocomplete": "username",
					"value":        values.Username,
				},
				fieldErrors["username"],
			)
			@form.Input(
				templ.Attributes{
					"type":         "password",
					"placeholder":  "Enter Password",
					"name":         "password",
					"autocomplete": "password",
				},
				fieldErrors["password"],
			)
			<div class="form-control mt-6">
				@form.Button("Login")
				<span hx-disinherit="*">
					Don't have an account ?
					<a href={ routes.Routes.SignupPage.Path } class="text-blue-600 hover:text-blue-800 hover:underline">Signup</a>
				</span>
			</div>
			@form.Error(fieldErrors[apperr.FieldGlobal])
			<div id="response-div"></div>
		</form>
	</div>
}
