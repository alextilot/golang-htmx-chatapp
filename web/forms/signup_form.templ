package forms

import (
	"github.com/alextilot/golang-htmx-chatapp/web/components/form"
	"github.com/alextilot/golang-htmx-chatapp/internal/routes"
	"github.com/alextilot/golang-htmx-chatapp/internal/apperr"
)

// SignupFormValues carries back what the user typed so a validation error
// doesn't wipe fields they already got right.
type SignupFormValues struct {
	Username string
	Email    string
}

templ SignupForm(fieldErrors apperr.FieldErrors, values SignupFormValues) {
	<div id="register-form" class="card shrink-0 w-full shadow-2xl bg-base-100 p-8" hx-ext="response-targets, debug">
		<h1 class="text-2xl font-semibold text-center">Signup</h1>
		<form
			class="card-body space-y-4"
			hx-boost="true"
			action={ routes.Routes.SignupPage.Path }
			method="post"
			hx-target="#register-form"
			hx-target-error="#register-form"
			hx-swap="outerHTML"
			hx-indicator="#spinner"
		>
			@form.Input(
				templ.Attributes{
					"type":         "text",
					"placeholder":  "Username",
					"name":         "username",
					"autocomplete": "username",
					"value":        values.Username,
				},
				fieldErrors["username"],
			)
			@form.Input(
				templ.Attributes{
					"type":         "email",
					"placeholder":  "Email",
					"name":         "email",
					"autocomplete": "email",
					"value":        values.Email,
				},
				fieldErrors["email"],
			)
			@form.Input(
				templ.Attributes{
					"type":         "password",
					"placeholder":  "Enter password",
					"name":         "password",
					"autocomplete": "password",
				},
				fieldErrors["password"],
			)
			@form.Input(
				templ.Attributes{
					"type":         "password",
					"placeholder":  "Confirm password",
					"name":         "repeatPassword",
					"autocomplete": "password",
				},
				fieldErrors["password"],
			)
			<div class="form-control mt-6">
				@form.Button("Sign up")
				<span hx-disinherit="*">
					Already have an account ?
					<a href={ routes.Routes.LoginPage.Path } class="text-blue-600 hover:text-blue-800 hover:underline">Login</a>
				</span>
			</div>
			@form.Error(fieldErrors[apperr.FieldGlobal])
			<div id="response-div"></div>
		</form>
	</div>
}
