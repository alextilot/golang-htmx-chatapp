{
  "name": "htmx-go-prototype",
  "version": "1.0.0",
  "description": "Server-side UI prototype with Go, HTMX, Templ, and Tailwind v4",
  "keywords": [
    "go",
    "htmx",
    "templ",
    "tailwind"
  ],
  "author": "Alex Tilot",
  "license": "ISC",
  "scripts": {
    "watch": "npx @tailwindcss/cli -i './web/static/css/style.css' -o './web/static/css/style.dist.css' --watch=always",
    "build": "npx @tailwindcss/cli -i './web/static/css/style.css' -o './web/static/css/style.dist.css' --minify",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/theme-change/index.js','web/static/js/theme-change.dist.js')\""
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.7.19",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "theme-change": "^3.0.4"
  }
}
