package form

templ LoginForm(errors map[string][]string) {
	<div id="login-form" class="card shrink-0 w-full shadow-2xl bg-base-100 p-8" hx-ext="response-targets, debug">
		<h1 class="text-2xl font-semibold text-center">Login</h1>
		<form
			class="card-body space-y-4"
			hx-boost="true"
			action="/login"
			method="post"
			hx-target="#login-form"
			hx-target-error="#login-form"
			hx-swap="outerHTML"
			hx-indicator="#spinner"
		>
			@form.FormInput(templ.Attributes{"type": "text", "placeholder": "Username", "name": "username", "autocomplete": "username"}, errors["username"])
			@FormInput(templ.Attributes{"type": "password", "placeholder": "Enter Password", "name": "password", "autocomplete": "current-password"}, errors["password"])
			<div class="form-control mt-6">
				@FormButton("Login")
				<span hx-disinherit="*">
					Don't have an account ?
					<a href="/signup" class="text-blue-600 hover:text-blue-800 hover:underline">Signup</a>
				</span>
			</div>
			if len(errors) != 0 {
				<p class="text-error text-sm mt-2">{ errors }</p>
			}
			<div id="response-div"></div>
		</form>
	</div>
}
