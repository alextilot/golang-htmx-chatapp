package components

templ FormSelect(attrs templ.Attributes, options []string, fieldErrors []string) {
	{{
		classes := HasErrorClass("select select-bordered w-full", fieldErrors, "select-error")
		label, attrs := ExtractAttribute[string](attrs, "label")
	}}
	<div class="form-control">
		if label != "" {
			<label class="label">
				<span class="label-text">{ label }</span>
			</label>
		}
		<select { attrs... } class={ classes }>
			for _, option := range options {
				<option value={ option }>{ option }</option>
			}
		</select>
		@FormError(fieldErrors)
	</div>
}
