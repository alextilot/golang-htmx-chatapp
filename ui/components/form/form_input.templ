package components

templ FormInput(attrs templ.Attributes, fieldErrors []string) {
	{{ classes := HasErrorClass("input input-bordered w-full", fieldErrors, "input-error") }}
	<div class="form-control">
		<input
			{ attrs... }
			class={ classes }
			autocapitalize="none"
			autocorrect="off"
		/>
		@FormError(fieldErrors)
	</div>
}
